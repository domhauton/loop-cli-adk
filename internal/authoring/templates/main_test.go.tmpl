func TestDiscoveryWithoutCredentials(t *testing.T) {
	p, err := project.New(manifest, func(string) string { t.Fatal("discovery read credentials"); return "" })
	if err != nil { t.Fatal(err) }
	var out, errout bytes.Buffer
	if status := cli.Run(context.Background(), p, []string{"describe"}, &out, &errout); status != 0 || !json.Valid(out.Bytes()) || errout.Len() != 0 {
		t.Fatalf("status=%d stdout=%s stderr=%s", status, &out, &errout)
	}
}

func TestNativeExecutable(t *testing.T) {
	if testing.Short() { t.Skip("compiles and executes the native CLI") }
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
	defer cancel()
	name := "[[.Name]]"
	if runtime.GOOS == "windows" { name += ".exe" }
	binary := filepath.Join(t.TempDir(), name)
	build := exec.CommandContext(ctx, "go", "build", "-o", binary, ".")
	if output, err := build.CombinedOutput(); err != nil { t.Fatalf("build: %v\n%s", err, output) }
	server := fixtureAPI(t)
	defer server.Close()
	t.Setenv("[[.BaseURLEnv]]", server.URL)
	t.Setenv("[[.TokenEnv]]", "fixture-only")
	cmd := exec.CommandContext(ctx, binary, "status", "get")
	cmd.Env = os.Environ()
	if output, err := cmd.CombinedOutput(); err != nil || string(output) != "{\"status\":\"ok\"}\n" { t.Fatalf("command: %v\n%s", err, output) }
}

func fixtureAPI(t *testing.T) *httptest.Server {
	t.Helper()
	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.Method != http.MethodGet || r.URL.RequestURI() != "/health" || r.Header.Get("Authorization") != "Bearer fixture-only" {
			t.Errorf("unexpected request method/path/auth")
			w.WriteHeader(http.StatusBadRequest)
			return
		}
		w.Header().Set("Content-Type", "application/json")
		fmt.Fprint(w, `{"status":"ok"}`)
	}))
}
